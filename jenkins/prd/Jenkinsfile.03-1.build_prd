// =====================================================================
// Jenkinsfile.build.prd — Mendix 앱 빌드 파이프라인 (PRD/운영 전용)
// 대상: Build 서버 (Jenkins Agent: build-node)
// 브랜치: main 고정
//
// 버전 관리 방식 — git tag로만 관리, "어떤 버전을 승격할지"는 자동 추측하지 않고
// 빌드 파라미터(RELEASE_VERSION)로 명시적으로 지정받는다:
//   - tag는 파일과 달리 git 병합 시 diff/충돌 개념이 없어서, automatically 추론하면
//     동시에 여러 rc 라인이 존재할 때 "어느 걸 승격할지" 판단이 근본적으로 불가능하다
//   - 그래서 병합 전략과 무관하게, 사람이 PR/릴리스 시점에 "이 버전을 승격한다"고
//     직접 지정하고, Jenkins는 그 값이 실제로 QA를 거쳤는지/중복 릴리스는 아닌지만 검증한다
//
// 흐름: GitHub Pull(relase) → RELEASE_VERSION 파라미터 검증 → Mendix Buildpack 빌드
//       → Docker 이미지 생성(해시 8자리 부착) → 운영 배포 승인 → Registry Push
//       → Git 태그(정식) → 배포 트리거
// =====================================================================

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 30, unit: 'MINUTES')
    }

    parameters {
        string(name: 'BRANCH', defaultValue: 'release', description: '운영 브랜치 입력(기본값 :  release) ')
        string(name: 'RELEASE_VERSION', defaultValue: '',
               description: '운영에 승격할 버전 (예: 1.3.0). QA에서 검증된 v{RELEASE_VERSION}-rc.* 태그가 반드시 존재해야 함') 
        booleanParam(name: 'ROLLBACK_ON_FAIL', defaultValue: false, description: '배포 실패 시 자동 롤백')       
    }

    environment {
        //태그 제한 갯수
        TAG_CNT_LIMIT = 20  
        DEPLOY_ENV = "prd"

        WRK_DTTM = new Date().format('yyyyMMddHHmmss').toString()
        APP_NAME = "mendix-iris"

        OS_USER = 'mxadmin'
        OS_OWNER = 'mendix'
                 
        //github,gitlab 환경변수 설정 
        GITHUB_URL = "https://github.samsungds.net/DS-N-PLM/iris-mx-app.git"
        GIT_CREDENTIAL_ID = 'prd-mx-nplm-git'
       // BRANCH_TAG = "${params.tag_branch}"
        BRANCH_NAME = "${params.BRANCH}"  
 
        //harbor,docker repogitory 환경변수 설정 
        DOCKER_ENDPOINT = "10.173.129.72:5001"      //deploy server 사용
        DOCKER_HOST_ENDPOINT = "ptdeploylxw01:5001"
        DOCKER_DIR_PREFIX = "iris/app"
         
        //mendix
        BUILD_PATH = 'mendixIris' 
        BLOBSTORE = 'http://10.173.129.72:28080'    //deploy server 사용
          
        DOCKER_BUILD_PACK_PATH = '/appdata/siemens/workspace/mx/mx_iris/docker-mendix-buildpack'
        APP_WRK_PATH = "/appdata/siemens/workspace/mx/mx_iris/${env.DEPLOY_ENV}/mxdeploy-dir"
        APP_DIR_PATH = "${APP_WRK_PATH}/${APP_NAME}"    
        MX_DESTINATION = "${APP_WRK_PATH}/${BUILD_PATH}"

        //etc
        // dubious ownership 오류 방지 — 파일(.gitconfig)에 의존하지 않고
        // 파이프라인 내 모든 git 프로세스(checkout() 포함)에 환경변수로 직접 주입
        GIT_CONFIG_COUNT   = '1'
        GIT_CONFIG_KEY_0   = 'safe.directory'
        GIT_CONFIG_VALUE_0 = '*'
       
               
    }

    stages {
        stage('Remote git Checkout') {
            steps {
                // GitLab Credential을 Jenkins 변수로 불러오기
                withCredentials([ string(credentialsId: GIT_CREDENTIAL_ID, variable: 'GITHUB_PAT')]) {
                    script {
                        def GITHUB_URL_WITH_CREDENTIAL = GITHUB_URL.replace('://','://${GITHUB_PAT}@')
                        sh """
                            
                            echo "--- Starting checkout process on deploy server ---" 
                             
                            # 1. 작업 디렉토리 정리
                            echo "--- cleaning up workspace: ${env.APP_WRK_PATH} ---"
                            sudo mkdir -p ${env.APP_WRK_PATH}
                            #sudo chmod 775 -R  ${env.APP_WRK_PATH}
                            sudo chown -R ${env.OS_USER}:${env.OS_OWNER} ${env.APP_WRK_PATH}

                            cd ${env.APP_WRK_PATH}

                            sudo rm -rf   ${env.APP_NAME}*  
                            sudo rm -rf   ${env.BUILD_PATH}  
                             
                            # 2. Git Clone 실행 (Shallow Clone)
                            echo "--- Cloning branch '${env.BRANCH_NAME}' into '${env.APP_NAME}' directory ---"

                            echo "Git 저장소에서 코드 체크아웃"  
                            sudo git clone --depth 1 --branch ${env.BRANCH_NAME} ${GITHUB_URL_WITH_CREDENTIAL}  ${env.APP_DIR_PATH}
   
                            cd ${env.APP_NAME}
  
                           # Jenkins에서 받은 브랜치명 사용 
                           ## 얕은 클론 방지 
                           ## sudo git rev-parse --ls-shallow-repository > /dev/null 2>&1

                           ## sudo git fetch ${GITHUB_URL_WITH_CREDENTIAL}  --unshallow || true

                           ## 태그 목록이 전부 있어야 git describe 가 정확하므로 전체 fetch 보장
                           sudo git fetch ${GITHUB_URL_WITH_CREDENTIAL}  --tags --force 

                            echo "--- deploy server checkout finished successfully ---"
                                  
                        """
                    }
                }
            }
        }
 

       // 빌드 버전 적용
        stage('Resolve Version') {
            steps {
                withCredentials([ string(credentialsId: GIT_CREDENTIAL_ID, variable: 'GITHUB_PAT')]) { 
           
                    script {
                        def GITHUB_URL_WITH_CREDENTIAL = GITHUB_URL.replace('://','://${GITHUB_PAT}@')

                        def baseVer = params.RELEASE_VERSION?.trim()
                         
                        if (!baseVer) {
                            error("RELEASE_VERSION 파라미터가 비어 있습니다. 승격할 버전(예: 1.3.0)을 명시적으로 입력하세요.")
                        }
                      
                        if (!(baseVer ==~ /^\d+\.\d+\.\d+$/)) {
                            error("RELEASE_VERSION 형식이 올바르지 않습니다: '${baseVer}' (예상 형식: X.Y.Z)")
                        }
                        
                        env.BASE_VERSION = "${baseVer}"  // 해당 버전 과거 버전삭제 처리를 위한 값 

                        // 1) 이 버전이 실제로 QA를 거쳤는지 검증 — {baseVer}-rc.* 태그가 하나 이상 있어야 함
                        def rcExists = sh(
                            script: "git -C '${env.APP_DIR_PATH}' tag -l '${baseVer}-rc.*' | wc -l",
                            returnStdout: true
                        ).trim()
                        if ((rcExists as int) == 0) {
                            error("${baseVer}-rc.* 태그를 찾을 수 없습니다 — QA 검증을 거치지 않은 버전은 운영에 승격할 수 없습니다.")
                        }

                        // 2) 이미 릴리스된 버전인지 검증 — 운영 태그는 "{baseVer}.{해시8자리}" 형식(점 구분)이므로
                        //    정확히 baseVer로 시작하는 정식(rc 아닌) 태그가 있는지 prefix로 확인
                        def prodExists = sh(
                            script: "git -C '${env.APP_DIR_PATH}' tag -l | grep -vE '\\-rc\\.' | grep -cE \"^${baseVer}(\\.[0-9a-f]{8})?\$\" || true",
                            returnStdout: true
                        ).trim()
                        if ((prodExists as int) > 0) {
                            error("${baseVer} 는 이미 운영에 릴리스된 버전입니다 — 중복 릴리스를 방지하기 위해 중단합니다.")
                        }

                        // 3) ★ main(=qa 겸용) 최신이 아니라, 검증된 rc 태그가 가리키는 "그 커밋"으로 체크아웃
                        //    main을 qa로 겸용하면 검증 이후에도 브랜치가 계속 앞으로 나갈 수 있으므로,
                        //    브랜치 최신을 그대로 빌드하면 검증 안 된 커밋까지 섞여 들어갈 위험이 있다.
                        def latestRcTag = sh(
                            script: "git -C '${env.APP_DIR_PATH}' tag -l '${baseVer}-rc.*' | sort -V | tail -1",
                            returnStdout: true
                        ).trim()
                        sh "sudo git -C '${env.APP_DIR_PATH}' checkout ${latestRcTag}"
                        echo "▶ 검증된 태그로 체크아웃 완료: ${latestRcTag}"

                        // 운영 이미지 태그 및 Git 태그 모두 "{baseVer}.{해시8자리}" 형식(점 구분) 사용
                        // (이제 HEAD는 위에서 체크아웃한 rc 커밋)
                        def shortSha = sh(
                            script: "git -C '${env.APP_DIR_PATH}' rev-parse --short=8 HEAD",
                            returnStdout: true
                        ).trim()
                       // env.GIT_SHORT_SHA = shortSha

                        env.APP_VERSION = "${baseVer}.${shortSha}" 
                        env.GIT_TAG     = "${baseVer}.${shortSha}"
                       
                        echo "▶ 승격 대상 버전: ${baseVer} (QA rc 태그 검증 완료, 중복 릴리스 아님)"
                        echo "▶ 빌드 버전: ${env.APP_VERSION} / GitHub: ${env.GIT_TAG}"
                      
 
                    }
                
                }
            }    
        }
 
        stage('Package buildpack / Image Build') {
            steps {
                script {
                    sh """ 
                        echo "--- Starting build on deploy server ---"

                        # 작업 디렉토리로 이동
                        cd "${env.APP_WRK_PATH}"
                        sudo mkdir -p "${env.MX_DESTINATION}"
                        sudo chown -R ${env.OS_USER}:${env.OS_OWNER} ${env.MX_DESTINATION}    
                        # === 3. 빌드팩 다운로드 및 Mendix 빌드 실행 ===
                        echo "--- Downloading buildpack and building MDA ---"

                        ##docker-mendix-buildpack-5.1.0
                        cd ${env.DOCKER_BUILD_PACK_PATH}

                        # ./build.py 실행
                        sudo ./build.py  --artifacts-repository ${env.DOCKER_ENDPOINT}/mendix-buildpack \
                                    --source ${env.APP_DIR_PATH} \
                                    --destination ${env.MX_DESTINATION} \
                                    build-mda-dir

                        # === 4. Docker 이미지 빌드 ===
                        echo "--- Building Docker Image ---"

                        ##docker build
                        docker build --label project=${env.APP_NAME} \
                                     --build-arg ROOTFS_IMAGE=mendix-rootfs:app \
                                     --build-arg BUILDER_ROOTFS_IMAGE=mendix-rootfs:builder \
                                     --build-arg EXCLUDE_LOGFILTER=true \
                                     --build-arg BLOBSTORE=${env.BLOBSTORE} \
                                     --build-arg BUILDPACK_XTRACE=true \
                                     -t ${env.APP_NAME}:${env.APP_VERSION} \
                                     -f ${env.MX_DESTINATION}/Dockerfile \
                                     ${env.MX_DESTINATION}

                        # === 5. Docker 이미지 푸시 및 정리 ===
                        echo "--- Tagging, Pushing, and Cleaning up Docker Image ---"

                        docker tag ${env.APP_NAME}:${env.APP_VERSION} ${env.DOCKER_HOST_ENDPOINT}/${env.DOCKER_DIR_PREFIX}/${env.APP_NAME}:${env.APP_VERSION}
                        docker push ${env.DOCKER_HOST_ENDPOINT}/${env.DOCKER_DIR_PREFIX}/${env.APP_NAME}:${env.APP_VERSION}

                        docker images --quiet --filter=dangling=true | xargs --no-run-if-empty docker rmi
                        ## label filter -> delete
                        docker image prune -a -f --filter 'label=project=${APP_NAME}'
                        sudo rm -rf '${MX_DESTINATION}'

                        echo "--- deploy server build finished successfully ---"
                    """
                }
            }
        }

        stage('Remote Git Tag and Push') {
            steps { 
                withCredentials([ string(credentialsId: GIT_CREDENTIAL_ID, variable: 'GITHUB_PAT')]) {
                    script {   
                        def GITHUB_URL_WITH_CREDENTIAL = GITHUB_URL.replace('://','://${GITHUB_PAT}@')

                        // 원격 서버에서 실행할 전체 셸 스크립트를 Groovy GString으로 생성
                        sh """
                       
                            echo "--- Starting Git Tagging process on deploy server ---" 
                
                            # === 2. 작업 디렉토리로 이동 ===
                            cd "${env.APP_DIR_PATH}"
                                        
                            # === 3. 기존 태그 존재 시 원격 태그 삭제 ===
                            # 로컬에 해당 태그가 있는지 확인
                            if [ \$(git tag -l | grep "^${env.GIT_TAG}" | wc -l) -ne 0 ]; then
                                echo "Local tag ${env.GIT_TAG} found. Deleting remote tag before pushing new one."
                                # git push ... :<tag>는 원격 태그를 삭제하는 명령어. 오류를 무시하기 위해 || true 추가
                                sudo git push  ${GITHUB_URL_WITH_CREDENTIAL} :${env.GIT_TAG} || true
                                # 로컬 태그도 삭제
                                #sudo git tag -d ${env.GIT_TAG}
                      
                            fi
 
                            # === 4. Git 사용자 설정 및 신규 태그 생성/푸시 ===
                            sudo git config --global user.email "pmp-jenkins@example.com"
                            sudo git config --global user.name "pmp-jenkins"   
   
                                                 
                            echo "Creating and pushing new tag: ${env.GIT_TAG}"
                            sudo git tag -a "${env.GIT_TAG}" -m "CI build ${env.APP_VERSION} (#${BUILD_NUMBER})"
                            sudo git push ${GITHUB_URL_WITH_CREDENTIAL}  ${env.GIT_TAG}
                             
                            # # 원격 저장소의 최신 상태(특히 태그)를 로컬로 반영
                            # sudo git fetch   ${GITHUB_URL_WITH_CREDENTIAL} --prune --prune-tags  
 
                            # # === 5. 오래된 태그 삭제 로직 ===
                            # echo "Checking for old tags to prune..."
                            # # 따옴표를 사용하여 "*develop*" 패턴을 올바르게 전달
                            # TAG_COUNT=\$(git tag --list --sort=-creatordate "v${BASE_VERSION}*" | wc -l)

                            # if [ "\${TAG_COUNT}" -gt "${env.TAG_CNT_LIMIT}" ]; then
                            #     # 가장 오래된 태그를 찾아서 삭제 (정렬 순서 수정 및 명령어 오류 수정)
                            #     OLDEST_TAG=\$(git tag --list --sort=creatordate "v${BASE_VERSION}*" | head -n 1)
                            #     echo "Tag limit exceeded. Deleting oldest tag: \${OLDEST_TAG}"
                            #     sudo git push ${GITHUB_URL_WITH_CREDENTIAL} --delete "\${OLDEST_TAG}"

                            # else
                            #     echo "Tag count (\${TAG_COUNT}) is within the limit (${env.TAG_CNT_LIMIT})."
                            # fi

                            echo "--- deploy server Git Tagging process finished successfully ---"
                        """
                    }
                }
            }
        }

        // Metadata 업데이트는 Jenkins에서 직접 수행
        stage('Update Jenkins Metadata') {
            steps {
                script {
                    currentBuild.displayName = "#${env.BUILD_NUMBER} ${env.APP_VERSION}"
                }
            }
        }           

        stage('Trigger CD Job') {
            steps {
                build job: "pm-planner-prd-app-deploy", 
                    wait: false,
                    parameters: [
                        string(name: 'IMAGE_TAG', value: "${env.APP_VERSION}"), 
                        string(name: 'GIT_TAG', value: "${env.GIT_TAG}"),
                        booleanParam(name: 'ROLLBACK_ON_FAIL', value: params.ROLLBACK_ON_FAIL) 
                    ]
            }
        }
    }  //stages end

    post {
        success {
            echo "[성공] CI Pipeline Succeeded "
        }
        failure {
            script {
                echo "[실패] CI Pipeline Failed."
            }
        }
        always {
            echo "CI Pipeline Finished"
            script {
                currentBuild.description = "CI Pipeline for version finished."
            }
            cleanWs()
        }
    }
}