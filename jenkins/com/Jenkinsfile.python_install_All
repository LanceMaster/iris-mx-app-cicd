    parameters {
        choice(name: 'TARGET_ENVIRONMENT', choices: ['qa', 'prd'], description: '작업할 환경을 선택하세요.') 
    }

    environment { 
         
        WRK_DTTM = new Date().format('yyyyMMddHHmmss').toString()  

        OS_USER = 'mxadmin'
        OS_OWNER = 'mxadmin'

  
        
       

        //github,gitlab 환경변수 설정 
        GITHUB_URL = "https://github.samsungds.net/DS-N-PLM/iris-mx-app.git"
        GIT_CREDENTIAL_ID = 'prd-mx-nplm-git'
        BRANCH_NAME = "iris-mx-cicd"

        APP_WRK_PATH = "/appdata/siemens/workspace/mx/mx_iris/${params.TARGET_ENVIRONMENT}/mxdeploy-dir"    
        APP_BRANCH_PATH = "${APP_WRK_PATH}/${BRANCH_NAME}"
        APP_COMPOSE_PATH = "${APP_WRK_PATH}/${BRANCH_NAME}/docker/${params.TARGET_ENVIRONMENT}"
  
    }

    stages {          
        stage('Git,Git Checkout, Python Module install') {
            steps {
            script { 
                        // try-catch 블록으로 원격 실행 실패 시 롤백 로직을 처리
                   try { 
                               def credentialsSSHId
                               def credentialsMxAdmId

                               if (params.TARGET_ENVIRONMENT == 'prd') {
                                  echo "Production 환경 선택됨."
                                    credentialsSSHId = "prd-new-mx-plm-app-node-pk"
                                    credentialsMxAdmId = "prd-mx-iris-node-pw"
                                } else {
                                   echo "QA 환경 선택됨."       
                                    credentialsSSHId = "qa-new-mx-plm-app-node-pk"
                                    credentialsMxAdmId = "qa-mx-iris-node-pw"
                                }     

                               withCredentials([
                                    sshUserPrivateKey(credentialsId: credentialsSSHId, keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER'), 
                                    string(credentialsId: GIT_CREDENTIAL_ID, variable: 'GITHUB_PAT'),
                                    string(credentialsId: credentialsMxAdmId, variable: 'COM_MX_ADM_PW')
                                ]) {   

                                    def GITHUB_URL_WITH_CREDENTIAL = "${GITHUB_URL.replace('://', "://${GITHUB_PAT}@")}"

                                    //# Jenkins 변수를 셸 변수로 설정
                                    initConfigEnv = [:]


                                   // 원격 서버에서 실행할 전체 셸 스크립트를 Groovy GString으로 생성 
                                    def remoteDeployGitScript = """
                                        #!/bin/bash
                                        # -e: 오류 발생 시 즉시 중단
                                        # -u: 정의되지 않은 변수 사용 시 오류
                                        # -x: 실행되는 모든 명령어를 출력
                                        # -o pipefail: 파이프라인의 어느 한 곳이라도 실패하면 전체 실패 처리
                                        # Git 설치 여부 확인
                                        if ! command -v git &> /dev/null;
                                        then
                                            echo "Git이 미설치 상태입니다. 설치를 시작합니다." 
                                            sudo dnf install -y git
                                        else
                                            echo "Git이 이미 설치되어 있습니다: \$(git --version)"
                                        fi
                                        
                                    """

                                    // 원격 서버에서 실행할 전체 셸 스크립트를 Groovy GString으로 생성
                                    def remoteDeployPythonScript = """
                                        #!/bin/bash
                                        # -e: 오류 발생 시 즉시 중단
                                        # -u: 정의되지 않은 변수 사용 시 오류
                                        # -x: 실행되는 모든 명령어를 출력
                                        # -o pipefail: 파이프라인의 어느 한 곳이라도 실패하면 전체 실패 처리

                                        echo "================================================="  
                                        echo "Remote CI/CD Python moduleCheckout               "
                                        echo "--- Checking out deployment repository ---       "      
                                        echo "================================================="       

                                        sudo mkdir -p ${env.APP_WRK_PATH}
                                        sudo chmod 775 -R  ${env.APP_WRK_PATH}
                                        sudo chown -R ${env.OS_USER}:${env.OS_OWNER}  ${env.APP_WRK_PATH}
                                        cd ${env.APP_WRK_PATH}
                                    
                                        # === 2. 배포 설정(docker-compose) 저장소 체크아웃 ===                           
                                        if [ -d "${env.BRANCH_NAME}" ]; then
                                            rm -rf "${env.BRANCH_NAME}"
                                        fi
                                        git clone --depth 1 --no-tags -b ${env.BRANCH_NAME} ${GITHUB_URL_WITH_CREDENTIAL}  ${env.BRANCH_NAME}
                                        
                                        echo "================================================="   
                                        echo "--- Starting python module on Remote Server ---"
                                        echo "================================================="    
  
                                        
                                        cd ${env.APP_BRANCH_PATH}            
                                                                    
                                        ## Python whl 모듈이 없는 경우 체크 설치  
                                        if ! python3.11 -m pip --version &> /dev/null; then
                                            echo "[info] pip 패키지가 없어 설치"
                                            sudo dnf install -y python3.11-pip
                                            echo "[info] pip 업데이트"
                                            python -m pip install ./wheels/pip-25.2-py3-none-any.whl --force-reinstall
                                        else
                                            echo "[info] pip 패키지가 이미 설치"
                                        fi
  
                                        ##pip show PyYAML
                                        ## whl 설치 여부 확인 후 자동 설치
                                        if ! pip show PyYAML > /dev/null 2>&1; then
                                            echo "[info] pyYaml 패키지가 없어 설치"
                                            python -m pip install ./wheels/pyyaml-6.0.3-cp311-cp311-manylinux2014_x86_64.whl --force-reinstall
                                        else
                                            echo "[info] pyYaml 패키지가 이미 설치"
                                            pip show PyYAML
                                        fi

                                       echo "--- Remote python module Finished Successfully ---"  
                                       
                                    """
                            
                                    if (params.TARGET_ENVIRONMENT == 'prd') {
                                        PRD_SERVERS.each { server ->
                                            
                                            //ssh mapping 
                                            server.user = "${SSH_USER}"
                                            server.identityFile = "${SSH_KEY}"

                                            echo "================================================="  
                                            echo "Prod Git Install"       
                                            echo "================================================="            
                                            // remoteExecute 함수를 호출하여 원격 서버에서 스크립트 실행
                                            remoteExecute(remote: server, command: sshRunAlwaysHeredoc(remoteDeployGitScript,initConfigEnv,false,false))           
                                       
                                            echo "================================================="  
                                            echo "Prod Python install with whl install                  "    
                                            echo "================================================="         
                                            
                                            remoteExecute(remote: server, command: sshRunAlwaysHeredoc(remoteDeployPythonScript,initConfigEnv,false,false))   

 
                                       
                                        }  
                                        initConfigEnv = [:]  //환경변수

                                    } else {
                                        QA_SERVERS.each { server ->
                                    
                                            //ssh mapping 
                                            server.user = "${SSH_USER}"
                                            server.identityFile = "${SSH_KEY}"

                                               echo "================================================="  
                                            echo "QA Git Install"       
                                            echo "================================================="            
                                            // remoteExecute 함수를 호출하여 원격 서버에서 스크립트 실행
                                            remoteExecute(remote: server, command: sshRunAlwaysHeredoc(remoteDeployGitScript,initConfigEnv,false,false))           
                                       
                                            echo "================================================="  
                                            echo "QA Python install with whl install                  "    
                                            echo "================================================="         
                                            
                                            remoteExecute(remote: server, command: sshRunAlwaysHeredoc(remoteDeployPythonScript,initConfigEnv,false,false))   
 
                                       }  
                                        initConfigEnv = [:]  //환경변수

                                    }

                                }  
                        } catch (e) {
                            // 원본 에러를 다시 발생시켜 빌드를 최종적으로 실패 처리
                            throw e
                        } 
                }
            }
        }  
  
    }

    post {
        success {
            echo "[성공] Deployment pipeline[Python Modules] succeeded."
        }
        failure {
            echo "[실패] Deployment pipeline[Python Modules] failed."
        }
        always {
            echo "Deployment pipeline[Python Modules] finished."
        }
    }    
}
