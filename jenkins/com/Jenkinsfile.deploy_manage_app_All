// =============================================================================
//  공통함수
// 1.단일 따옴표 안전 이스케이프 : ' -> '"'"' 
// =============================================================================
def toShEscape = {String v ->    
    if (v == null) return "''"
    def vEx =  "'" + v.replace("'", "'\"'\"'") + "'" 
    // echo "jenkins toShEscape: ${vEx}"
    return vEx
}

// =============================================================================
//  공통함수
// 2.env 맵을  export 구문(AND 체인)으로 변환
// =============================================================================
def toExportChain = {Map<String, Object> envMap -> 
    envMap.collect { k,v -> "export ${k}=" +
    toShEscape(v?.toString() ?: "")}.join(' && ')
}

// =============================================================================
// 공통함수
// 3.오른쪽 공백 제거
// =============================================================================
def rtrim = {String rt -> 
    if (rt == null) return ''
    //줄 끝의 공백/탭 등만 제거
    return rt.replaceAll(/\s+$/,'')
}

// =============================================================================
// 공통함수
// 3.멀티라인 명령 -> 빈줄/주석 제거하고 원래 줄 구조 유지
// =============================================================================
def toFilteredLiner = {String cmd -> 
    cmd.readLines()
        .collect { line -> rtrim(line) }   //끝 공백만 제거
        .findAll { line ->
            def t = line.trim()
                return t && !t.startsWith('#')     //빈줄/주석 제외
        }
        .join('\n')     //줄바꿈
}
    
// =============================================================================
//  공통함수
// 4.sshRunAlwaysHeredoc(host,user,credId,rawCmd, extraEnv = [:], sudoE = false)
// rawCmd : 멀티라인 (자동  && 체인)
// extraEnv : export 앞에 주입
// sudoE : true 면 'sudo -E bash -lc' 로 실행
// returnE : true 면 결과값을 리턴
// =============================================================================
def sshRunAlwaysHeredoc = {String rawCmd,Map<String,Object> extraEnv = [:], boolean sudoE = false, boolean returnE = false  ->
    // echo "jenkins env: ${sshconfig}"
    //기본 env + 추가 envi
    // 공통 환경변수 선언 
    //APP_PATH : env.APP_PATH,
    //TAG : env.TAG
    Map<String,Object> mergedEnv = [
        OS_USER : "${env.OS_USER}",        
        OS_OWNER : "${env.OS_OWNER}",
//        APP_WRK_PATH : "${env.APP_WRK_PATH}", 
//        APP_BRANCH_PATH : "${env.APP_BRANCH_PATH}",
//        APP_COMPOSE_PATH : "${env.APP_COMPOSE_PATH}",
//        GITHUB_URL : "${env.GITHUB_URL}",
        BRANCH_NAME : "${env.BRANCH_NAME}"] + extraEnv

    String exportChain = toExportChain(mergedEnv)
    String bashPrefix = sudoE ? 'sudo -E bash -lc' : 'bash -lc'
    def filterRawCmd = toFilteredLiner(rawCmd)
    String scriptBody
 
   if  (returnE) { 
    // 제어문 : heredoc으로 안전하게 전달 (원격에서 변수 확장)
    scriptBody = """
        ${bashPrefix} ${toShEscape("""\
        set -eo pipefail 
        TMPDIR=\$(mktemp -d /tmp/jenkins_cmd_XXXXXXXXXXXX)
        trap 'rc=\$?; rm -rf "\$TMPDIR"; exit \$rc' EXIT INT TERM
cat <<'EOS' > "\$TMPDIR/tmprun.sh"
#!/bin/bash
set -eo pipefail
${exportChain}
\n
${filterRawCmd}
exit 0
EOS
        chmod 777 "\$TMPDIR"
        chmod +x "\$TMPDIR/tmprun.sh"
        ##"\$TMPDIR/tmprun.sh"
        ## 스크립트 실행(stderr는 콘솔 stdoutd은 변수로) 
        OUT=\$(echo '$COM_MX_ADM_PW' | su - $OS_USER -c "bash \$TMPDIR/tmprun.sh" 2> >(cat 1>&2) || true)
        ## __RESULT__: 로 시작하는 마지막 줄만 추출
        LINE=\$(printf "%s" "\$OUT" | awk '/^__RESULT__:/ {keep=\$0} END{if(keep) print keep}')
        ##접두사 제거 및 트리밍
        LAST_LINE=\$(printf "%s" "\$LINE" | sed -E 's/^__RESULT__:\\s*//; s/^\\s+//; s/\\s+\$//')
        printf "%s\\n" "\$LAST_LINE" 
        """.stripIndent())}
    """.trim()

    } else {

     // 제어문 : heredoc으로 안전하게 전달 (원격에서 변수 확장)
    scriptBody = """
        ${bashPrefix} ${toShEscape("""\
        set -eo pipefail 
        TMPDIR=\$(mktemp -d /tmp/jenkins_cmd_XXXXXXXXXXXX)
        trap 'rc=\$?; rm -rf "\$TMPDIR"; exit \$rc' EXIT INT TERM
cat <<'EOS' > "\$TMPDIR/tmprun.sh"
#!/bin/bash
set -eo pipefail
${exportChain}
\n
${filterRawCmd}
exit 0
EOS
        chmod 777 "\$TMPDIR"
        chmod +x "\$TMPDIR/tmprun.sh"
        echo '$COM_MX_ADM_PW' | su - $OS_USER -c "bash \$TMPDIR/tmprun.sh"
    
        """.stripIndent())}
    """.trim()   
}
    return scriptBody
}
 

// =============================================================================
//  원격 실행 함수 (Remote Execution Function)
// =============================================================================
/**
 * 원격 서버에서 셸 커맨드를 실행.
 * @param config Map: 실행 설정값
 * - remote: sshCommand에 전달할 원격 서버 정보 (name, host, user, credentialsId 등)
 * - command: 원격 서버에서 실행할 셸 스크립트 문자열
 */
def remoteExecute(Map config) {
    // sshCommand 스텝을 사용하여 원격지에서 스크립트 실행
     sshCommand (remote: config.remote, command: config.command)
}

// =============================================================================
//  원격 실행 함수 (Remote Execution Function)
// =============================================================================
/**
 * 원격 서버에서 셸 커맨드를 실행하고 그 결과를 반환합니다.
 * 사용자스크립트에 아래 추가 
 *  리턴 값을 사용하는 경우 아래와 같이 __RESULT__ 에 값을 대입하여 보냄
 *  printf "__RESULT__:%s\\n" "\$LATEST_TAG" 
 * @param config Map: 실행 설정값  , failOnError: false
 * - remote: sshCommand에 전달할 원격 서버 정보 (name, host, user, credentialsId 등)
 * - command: 원격 서버에서 실행할 셸 스크립트 문자열 * 
 * @return String: 원격 명령어의 표준 출력(stdout) 결과
 */
def remoteExecuteAndGetOutput(Map config) {
 
    def raw = sshCommand (remote: config.remote, command: config.command) 
    def resultOut = raw?.trim()
    //실행 결과를 반환받음
    return resultOut?.length() ? resultOut : null
}

// =============================================================================
//  재기동 파이프라인 (Pipeline) 
// =============================================================================
pipeline {
    agent any
    
    parameters {
        choice(name: 'TARGET_ENVIRONMENT', choices: ['qa', 'prd'], description: '작업할 환경을 선택하세요.')
        choice(name: 'ACTION', choices: ['Restart','Start', 'Stop'], description: '수행할 작업을 선택하세요.')
        string(name: 'TAG_VERSION', defaultValue: '',
               description: '작업할 태그 선택 미입력시 최신 태그로 실행됨 QA(예:QADC-1.0.1-rc.1), PRD(예:PDDC-1.0.1.b590af8d)') 
        booleanParam(name: 'VM_ONE', defaultValue: true, description: '1번 서버 작업여부.')
        booleanParam(name: 'VM_TWO', defaultValue: true, description: '2번 서버 작업여부.')
    }

    environment {

        WRK_DTTM = new Date().format('yyyyMMddHHmmss').toString()  

        OS_USER = 'mxadmin'
        OS_OWNER = 'mxadmin'
 
        CONTAINER_NAME            = "mendix-iris"
        APP_PORT                  = '8080' 
    }

    stages {
        stage('Manage App Container'){
            steps{
                script {
                    try {
                        
                        def targetContainerName
                        def credentialsSSHId
                        def credentialsMxAdmId

                        if (params.TARGET_ENVIRONMENT == 'Prod') {
                            echo "Production 환경 선택됨."
                           
                            targetContainerName = env.CONTAINER_NAME
                            credentialsSSHId = 'prd-new-mem-mx-app-node-pk'
                            credentialsMxAdmId = 'prd-mx-plm-adm-node-pw'

                        } else {
                            echo "QA 환경 선택됨."                            
                           
                            targetContainerName = "${env.CONTAINER_NAME}-qa"
                            credentialsSSHId =   'qa-new-mx-plm-app-node-pk'
                            credentialsMxAdmId = 'qa-mx-plm-adm-node-pw'
                        }

                        withCredentials([
                            sshUserPrivateKey(credentialsId: credentialsSSHId, keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER'),
                            string(credentialsId: credentialsMxAdmId, variable: 'COM_MX_ADM_PW')
                        ]) {

                            //mxadmin pw
                            initConfigEnv = [COM_MX_ADM_PW : "${env.COM_MX_ADM_PW}"] 
  
                            servers.each { server ->
                                echo "===== 서버 [${server.name}] 작업 시작 / 액션: ${params.ACTION} ====="
                                //마지막 요소(boolean)을 가져옴
                                def executeTask = server.vmset 

                                if (params.ACTION == 'Restart') {
                                   
                                    if (executeTask) {           

                                        def restartAPPScript = restartAPPScript(server,targetContainerName)         
                                        sshExecute(server, sshDeployAlwaysHeredoc(restartAPPScript,initConfigEnv,false))    
                                        verifyServer(server)                                     

                                    } else {
                                        echo "Restart를 건너뜁니다 : ${server.name}" 
                                    }
                                   
                                     
                                // } else if (params.ACTION == 'Delete') {
                                   
                                //     if (executeTask) {                                

                                //        def deleteAPPScript = deleteAPPScript(server,targetContainerName)         
                                //        sshExecute(server, sshDeployAlwaysHeredoc(deleteAPPScript,initConfigEnv,false)) 

                                //     } else {
                                //         echo "Delete를 건너뜁니다 : ${server.name}" 
                                //     }
                                       
 
                                } else if (params.ACTION == 'Start') {
                                    
                                    if (executeTask) {    
                                        def startAPPScript = startAPPScript(server,targetContainerName)         
                                        sshExecute(server, sshDeployAlwaysHeredoc(startAPPScript,initConfigEnv,false))    
 
                                        verifyServer(server)

                                    } else {
                                        echo "Start를 건너뜁니다 : ${server.name}" 
                                    }
                                   

                                } else if (params.ACTION == 'Stop') {

                                    if (executeTask) {   
                                        def stopAPPScript = stopAPPScript(server,targetContainerName)         
                                        sshExecute(server, sshDeployAlwaysHeredoc(stopAPPScript,initConfigEnv,false))    

                                    } else {
                                        echo "Stop를 건너뜁니다 : ${server.name}" 
                                    }
                                   
  
                                }
                                echo "===== 서버 [${server.name}] 작업 완료 ====="
                            }
                        }
                    } catch (Exception e) {
                        error("Manage App Container 실패: ${e.getMessage()}")
                        echo "Full error: ${e.toString()}"
                    }
                }
            }
        }
    }

    post {
        success {
            echo "[성공] CI Pipeline Succeeded "
        }
        failure {
            script {
                echo "[실패] CI Pipeline Failed."
            }
        }
        always {
            echo "CI Pipeline Finished"
            script {
                currentBuild.displayName = "#${env.BUILD_NUMBER} - 작업 : ${params.TARGET_ENVIRONMENT} - ${params.ACTION}"
                currentBuild.description = "작업 : ${params.TARGET_ENVIRONMENT} - ${params.ACTION}"
            }
        }
    }
}

// === FUNCTIONS ===
def sshExecute(server, command) {
    sshCommand remote: [
        name: server.name,
        host: server.host,
        user: SSH_USER,
        identityFile: SSH_KEY,
        allowAnyHosts: true
    ], command: command
}

def restartAPPScript(server, containerName) {
    def restartAPPScript =  """
        set -euo pipefail
        echo "서버 [${server.name}]에서 컨테이너 [${containerName}] 재시작을 시도합니다."
        CONTAINER_ID=\$(docker ps -q -f "name=^/${containerName}\$")
        if [ -n "\$CONTAINER_ID" ]; then
            echo "실행 중인 컨테이너 '${containerName}' (ID: \$CONTAINER_ID)를 재시작합니다."
            docker restart \$CONTAINER_ID
            echo "컨테이너 '${containerName}'가 성공적으로 재시작되었습니다."
        else
            echo "오류: 서버 [${server.name}]에서 '${containerName}' 이름의 실행 중인 컨테이너를 찾을 수 없습니다."
            exit 1
        fi
    """
    return restartAPPScript
}

def deleteAPPScript(server, containerName) {
    def deleteAPPScript =  """
        set -euo pipefail
        echo "서버 [${server.name}]에서 컨테이너 [${containerName}] 삭제를 시도합니다."
        CONTAINER_ID=\$(docker ps -aq -f "name=^/${containerName}\$")
        if [ -n "\$CONTAINER_ID" ]; then
            echo "컨테이너 '${containerName}' (ID: \$CONTAINER_ID)를 강제 삭제합니다."
            docker rm -f \$CONTAINER_ID
            echo "컨테이너 '${containerName}'가 성공적으로 삭제되었습니다."
        else
            echo "경고: 서버 [${server.name}]에서 '${containerName}' 이름의 컨테이너를 찾을 수 없습니다."
        fi
    """
    return deleteAPPScript
}

def stopAPPScript(server, containerName) {
    def stopAPPScript =  """
        set -euo pipefail
        echo "서버 [${server.name}]에서 컨테이너 [${containerName}] 중지를 시도합니다."
        CONTAINER_ID=\$(docker ps -q -f "name=^/${containerName}\$")
        if [ -n "\$CONTAINER_ID" ]; then
            echo "실행 중인 컨테이너 '${containerName}' (ID: \$CONTAINER_ID)를 중지합니다."
            docker stop \$CONTAINER_ID
            echo "컨테이너 '${containerName}'가 성공적으로 중지되었습니다."
        else
            echo "경고: '${containerName}' 컨테이너가 실행 중이지 않습니다."
        fi
    """
    return stopAPPScript
}

def startAPPScript(server, containerName) {

    def startAPPScript = """
        set -euo pipefail
        echo "서버 [${server.name}]에서 컨테이너 [${containerName}] 시작을 시도합니다."
        # 이미 실행 중인지 확인
        RUNNING_ID=\$(docker ps -q -f "name=^/${containerName}\$")
        if [ -n "\$RUNNING_ID" ]; then
            echo "경고: 컨테이너 '${containerName}'가 이미 실행 중입니다."
            exit 0
        fi

        # 중지된 컨테이너 중에서 검색
        STOPPED_ID=\$(docker ps -aq -f "name=^/${containerName}\$")
        if [ -n "\$STOPPED_ID" ]; then     
            echo "중지된 컨테이너 '${containerName}' (ID: \$STOPPED_ID)를 시작합니다."
            docker start \$STOPPED_ID
            echo "컨테이너 '${containerName}'가 성공적으로 시작되었습니다."
        else
            echo "오류: 시작할 '${containerName}' 컨테이너를 찾을 수 없습니다."
            exit 1
        fi
    """

    return startAPPScript
}

def verifyServer(server) {
    sshExecute(server, """
        echo "애플리케이션 상태 점검 시작"
        for i in {1..10}; do
            if curl -s --fail http://${server.host}:${server.port}/${env.APP_LOGIN_SUB_URL} > /dev/null; then
                echo "애플리케이션이 성공적으로 응답했습니다."
                exit 0
            fi
            echo "응답 없음. 10초 후 재시도... (\$i/5)"
            sleep 10
        done
        echo "오류: 애플리케이션이 제한 시간 내에 응답하지 않았습니다."
        exit 1
    """)
}
