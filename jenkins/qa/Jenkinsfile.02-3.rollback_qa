]

def Map<String, Object> initConfigEnv = [:]  //환경변수

// =============================================================================
//  공통함수
// 1.단일 따옴표 안전 이스케이프 : ' -> '"'"' 
// =============================================================================
def toShEscape = {String v ->    
    if (v == null) return "''"
    def vEx =  "'" + v.replace("'", "'\"'\"'") + "'" 
    // echo "jenkins toShEscape: ${vEx}"
    return vEx
}

// =============================================================================
//  공통함수
// 2.env 맵을  export 구문(AND 체인)으로 변환
// =============================================================================
def toExportChain = {Map<String, Object> envMap -> 
    envMap.collect { k,v -> "export ${k}=" +
    toShEscape(v?.toString() ?: "")}.join(' && ')
}

// =============================================================================
// 공통함수
// 3.오른쪽 공백 제거
// =============================================================================
def rtrim = {String rt -> 
    if (rt == null) return ''
    //줄 끝의 공백/탭 등만 제거
    return rt.replaceAll(/\s+$/,'')
}

// =============================================================================
// 공통함수
// 3.멀티라인 명령 -> 빈줄/주석 제거하고 원래 줄 구조 유지
// =============================================================================
def toFilteredLiner = {String cmd -> 
    cmd.readLines()
        .collect { line -> rtrim(line) }   //끝 공백만 제거
        .findAll { line ->
            def t = line.trim()
                return t && !t.startsWith('#')     //빈줄/주석 제외
        }
        .join('\n')     //줄바꿈
}

// =============================================================================
//  공통함수
// 4.sshRunAlwaysHeredoc(host,user,credId,rawCmd, extraEnv = [:], sudoE = false)
// rawCmd : 멀티라인 (자동  && 체인)
// extraEnv : export 앞에 주입
// sudoE : true 면 'sudo -E bash -lc' 로 실행
// returnE : true 면 결과값을 리턴
// =============================================================================
def sshRunAlwaysHeredoc = {String rawCmd,Map<String,Object> extraEnv = [:], boolean sudoE = false, boolean returnE = false  ->
    // echo "jenkins env: ${sshconfig}"
    //기본 env + 추가 envi
    // 공통 환경변수 선언 
    //APP_PATH : env.APP_PATH,
    //TAG : env.TAG
    Map<String,Object> mergedEnv = [
        OS_USER : "${env.OS_USER}",        
        OS_OWNER : "${env.OS_OWNER}"    
        ] + extraEnv

    String exportChain = toExportChain(mergedEnv)
    String bashPrefix = sudoE ? 'sudo -E bash -lc' : 'bash -lc'
    def filterRawCmd = toFilteredLiner(rawCmd)
    String scriptBody
 
   if  (returnE) { 
    // 제어문 : heredoc으로 안전하게 전달 (원격에서 변수 확장)
    scriptBody = """
        ${bashPrefix} ${toShEscape("""\
        set -eo pipefail 
        TMPDIR=\$(mktemp -d /tmp/jenkins_cmd_XXXXXXXXXXXX)
        trap 'rc=\$?; rm -rf "\$TMPDIR"; exit \$rc' EXIT INT TERM
cat <<'EOS' > "\$TMPDIR/tmprun.sh"
#!/bin/bash
set -eo pipefail
${exportChain}
\n
${filterRawCmd}
exit 0
EOS
        chmod 777 "\$TMPDIR"
        chmod +x "\$TMPDIR/tmprun.sh"
        ##"\$TMPDIR/tmprun.sh"
        ## 스크립트 실행(stderr는 콘솔 stdoutd은 변수로) 
        OUT=\$(echo '$QA_MX_ADM_PW' | su - $OS_USER -c "bash \$TMPDIR/tmprun.sh" 2> >(cat 1>&2) || true)
        ## __RESULT__: 로 시작하는 마지막 줄만 추출
        LINE=\$(printf "%s" "\$OUT" | awk '/^__RESULT__:/ {keep=\$0} END{if(keep) print keep}')
        ##접두사 제거 및 트리밍
        LAST_LINE=\$(printf "%s" "\$LINE" | sed -E 's/^__RESULT__:\\s*//; s/^\\s+//; s/\\s+\$//')
        printf "%s\\n" "\$LAST_LINE" 
        """.stripIndent())}
    """.trim()

    } else {

     // 제어문 : heredoc으로 안전하게 전달 (원격에서 변수 확장)
    scriptBody = """
        ${bashPrefix} ${toShEscape("""\
        set -eo pipefail 
        TMPDIR=\$(mktemp -d /tmp/jenkins_cmd_XXXXXXXXXXXX)
        trap 'rc=\$?; rm -rf "\$TMPDIR"; exit \$rc' EXIT INT TERM
cat <<'EOS' > "\$TMPDIR/tmprun.sh"
#!/bin/bash
set -eo pipefail
${exportChain}
\n
${filterRawCmd}
exit 0
EOS
        chmod 777 "\$TMPDIR"
        chmod +x "\$TMPDIR/tmprun.sh"
        echo '$QA_MX_ADM_PW' | su - $OS_USER -c "bash \$TMPDIR/tmprun.sh"
    
        """.stripIndent())}
    """.trim()   
}
    return scriptBody
}


// =============================================================================
//  원격 실행 함수 (Remote Execution Function)
// =============================================================================
/**
 * 원격 서버에서 셸 커맨드를 실행.
 * @param config Map: 실행 설정값
 * - remote: sshCommand에 전달할 원격 서버 정보 (name, host, user, credentialsId 등)
 * - command: 원격 서버에서 실행할 셸 스크립트 문자열
 */
def remoteExecute(Map config) {
    // sshCommand 스텝을 사용하여 원격지에서 스크립트 실행
     sshCommand remote: config.remote, command: config.command
}

// =============================================================================
//  원격 실행 함수 (Remote Execution Function)
// =============================================================================
/**
 * 원격 서버에서 셸 커맨드를 실행하고 그 결과를 반환합니다.
 * 사용자스크립트에 아래 추가 
 *  리턴 값을 사용하는 경우 아래와 같이 __RESULT__ 에 값을 대입하여 보냄
 *  printf "__RESULT__:%s\\n" "\$LATEST_TAG" 
 * @param config Map: 실행 설정값
 * - remote: sshCommand에 전달할 원격 서버 정보 (name, host, user, credentialsId 등)
 * - command: 원격 서버에서 실행할 셸 스크립트 문자열 * 
 * @return String: 원격 명령어의 표준 출력(stdout) 결과
 */
def remoteExecuteAndGetOutput(Map config) {
 
    def raw = sshCommand (remote: config.remote, command: config.command) 
    def resultOut = raw?.trim()
    //실행 결과를 반환받음
    return resultOut?.length() ? resultOut : null
}

// =============================================================================
//  메인 파이프라인 (Main Pipeline)
//  DEV MPR to image
// =============================================================================
pipeline {
    agent any
    
    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
    }    

    //빌드 파라미터 정의
    parameters {
        string(name: 'rollback_branch', defaultValue: 'iris-mx-cicd', description: 'rollback-branch')
        string(name: 'rollback_tagversion', defaultValue: '' , description: 'rollback tag version(예:QADC-1.0.1-rc.1)')
    }

    environment {
        //태그 제한 갯수
        TAG_CNT_LIMIT = 5
        BUILD_MODE = "QADC-"
        DEPLOY_ENV = "qa"

        WRK_DTTM = new Date().format('yyyyMMddHHmmss').toString()  
        APP_NAME = "mendix-iris-${env.DEPLOY_ENV}"

        OS_USER = 'mxadmin'
        OS_OWNER = 'mxadmin' 
 
        APP_DOMAIN_NAME = 'pmsimqa-plm.samsungds.net'
        APP_PORT = '8080'
        RUNTIME_PORT = '8080'
        M2EE_ADMIN_PORT = '8081'
        SSH_CREDENTIAL_ID = "qa-new-mx-plm-app-node-pk"

        APP_WRK_PATH = "/appdata/siemens/workspace/mx/mx_iris/${env.DEPLOY_ENV}/mxdeploy-dir" 
       // APP_DIR_PATH = "${APP_WRK_PATH}/${APP_NAME}"      
        APP_BRANCH_PATH = "${APP_WRK_PATH}/${params.rollback_branch}"
        APP_COMPOSE_PATH = "${APP_WRK_PATH}/${params.rollback_branch}/docker/${DEPLOY_ENV}"

        //github,gitlab 환경변수 설정 
        GITHUB_URL = "https://github.samsungds.net/DS-N-PLM/iris-mx-app.git"
        GIT_CREDENTIAL_ID = 'prd-mx-nplm-git'
        BRANCH_NAME = "${params.rollback_branch}"
        BRANCH_TAG = "${params.rollback_tagversion}"
        ROLLBACK_BRANCH = "rollback" 

  
        DOCKER_ENDPOINT = "10.173.129.72:5001"     //deploy server 변경
        DOCKER_HOST_ENDPOINT = "ptdeploylxw01:5001" 
        DOCKER_DIR_PREFIX = "iris/app"
    
      //mendix   
        BLOBSTORE = 'http://10.173.129.72:28080'    //deploy server 사용

        //etc    
        APP_METRIC_PORT = '8082'
        MXRUNTIME_APPLICATION_ROOT_URL = "https://${APP_DOMAIN_NAME}:${RUNTIME_PORT}/"
     
        // dubious ownership 오류 방지 — 파일(.gitconfig)에 의존하지 않고
        // 파이프라인 내 모든 git 프로세스(checkout() 포함)에 환경변수로 직접 주입
        GIT_CONFIG_COUNT   = '1'
        GIT_CONFIG_KEY_0   = 'safe.directory'
        GIT_CONFIG_VALUE_0 = '*'

    }

    stages {    
        stage('Parameter Validation') {
            steps {
                script {
                    if (!params.rollback_tagversion.trim().isEmpty()) {
                        if (params.rollback_tagversion.startsWith("${env.BUILD_MODE}")) {
                            echo "배포[RollBack]할 버전 : ${env.BRANCH_TAG}"
                        } else { 
                            error "배포[RollBack]할 버전이 ${env.BUILD_MODE}로 시작하지 않습니다."
                        }
                    } 
 
                }
            }
        }    
  
        stage('Remote Checkout QA Server 1') {
            steps {
                // GitLab Credential을 Jenkins 변수로 불러오기
                withCredentials([
                   sshUserPrivateKey(credentialsId: SSH_CREDENTIAL_ID, keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER'),
                    string(credentialsId: GIT_CREDENTIAL_ID, variable: 'GITHUB_PAT'),
                    string(credentialsId: 'qa-mx-iris-node-pw', variable: 'QA_MX_ADM_PW')
                ]) {
                    script {                        
 
                        //# Jenkins 변수를 셸 변수로 설정
                        initConfigEnv = [BRANCH_TAG:"${env.BRANCH_TAG}"]
 
                        
                        def remoteCheckoutScript = ""
                        def QAServer = QA_SERVERS[0]      
                        //ssh mapping  
                        QAServer.user = "${SSH_USER}"
                        QAServer.identityFile = "${SSH_KEY}"
                        // try-catch 블록으로 원격 실행 실패 시 롤백 로직을 처리
                        try {
  
                            //github cicd checkout
                            remoteCheckoutScript = checkoutCode()  
                            echo "--- check ${env.BRANCH_TAG} ---"      
                            // remoteExecute 함수를 호출하여 원격 서버에서 스크립트 실행                             
                            BRANCH_TAG = remoteExecuteAndGetOutput(remote: QAServer, command: sshRunAlwaysHeredoc(remoteCheckoutScript,initConfigEnv,false,true))       
                            echo "--- check ${BRANCH_TAG} ---"                                                          
                            if (BRANCH_TAG == "1") {
                            error "rollback 버전이 없습니다. github 에서 rollback tag 버전 확인후 수동 배포하십시요."
                            }  
            
                            initConfigEnv = [:]  //환경변수                             
                             
                        } catch (e) { 
                            // 원본 에러를 다시 발생시켜 빌드를 최종적으로 실패 처리
                            throw e
                        }  
                    }
                }
            }
        }
 
        // 젠킨스 credentials 추출
        stage('Deploy and Verify QA Server 1') {
            steps { 
                    withCredentials([
                        sshUserPrivateKey(credentialsId: SSH_CREDENTIAL_ID, keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER') , 
                        usernamePassword(credentialsId: 'qa-mem-mx-iris-db-credentials',usernameVariable: 'DB_USER', passwordVariable: 'DB_PASS') ,
                        usernamePassword(credentialsId: 'qa-mx-iris-nplm-db-credentials',usernameVariable: 'NPLM_USER', passwordVariable: 'NPLM_PW') ,
                        string(credentialsId: 'qa-mem-mx-iris-mendix-lic-credentials', variable: 'LIC_KEY') ,
                        string(credentialsId: 'qa-mx-iris-adm-app', variable: 'ADMIN_PASS'),
                        string(credentialsId: 'qa-mx-iris-iam-api-user-pw', variable: 'IAMAPIUSER_PW'),       
                        string(credentialsId: 'qa-mx-iris-saml20-keystore-pw', variable: 'SAML20_KEYSTORE_PASSWORD'),   
                        string(credentialsId: 'qa-mx-iris-nplm-consumer-api-key', variable: 'NPLM_DEFAULT_CONSUMER_API_KEY'), 
                        string(credentialsId: 'qa-mx-iris-nplm-consumer-pw', variable: 'NPLM_DEFAULT_CONSUMER_PWD') ,    
                        string(credentialsId: 'qa-mx-iris-node-pw', variable: 'QA_MX_ADM_PW')
                    ]) {
                     script {   
 
                        //# Jenkins 변수를 셸 변수로 설정
                        initConfigEnv = [:]
 
                        echo "--- Running Deploy and Verify ---"

                        def remoteEnvScript = ""
   
                        def envContent = """
DB_USER='${DB_USER}'
DB_PASS='${DB_PASS}'
NPLM_USER='${NPLM_USER}'
NPLM_PW='${NPLM_PW}'
LICENSE_KEY='${LIC_KEY}'
ADMIN_PASS='${ADMIN_PASS}'
IAMAPIUSER_PW='${IAMAPIUSER_PW}'
SAML20_KEYSTORE_PASSWORD='${SAML20_KEYSTORE_PASSWORD}'
NPLM_DEFAULT_CONSUMER_API_KEY='${NPLM_DEFAULT_CONSUMER_API_KEY}'
NPLM_DEFAULT_CONSUMER_PWD='${NPLM_DEFAULT_CONSUMER_PWD}'
                        """   

                        def QAServer = QA_SERVERS[0]         
                        //ssh mapping  
                        QAServer.user = "${SSH_USER}"
                        QAServer.identityFile = "${SSH_KEY}"
                        // try-catch 블록으로 원격 실행 실패 시 롤백 로직을 처리
                        try {
                    
                            remoteEnvScript = envScript(envContent)        
                            // remoteExecute 함수를 호출하여 원격 서버에서 스크립트 실행                             
                            remoteExecute(remote: QAServer, command: sshRunAlwaysHeredoc(remoteEnvScript,initConfigEnv,false,false))  
        
                            initConfigEnv = [:]  //환경변수       
 
                        } catch (e) { 
                            // 원본 에러를 다시 발생시켜 빌드를 최종적으로 실패 처리
                            throw e
                        }
                    }
                }
            }
        }

        stage('Execute Remote Deployment QA Server 1') {
            steps {
                withCredentials([ 
                    string(credentialsId: GIT_CREDENTIAL_ID, variable: 'GITHUB_PAT'),
                    sshUserPrivateKey(credentialsId: SSH_CREDENTIAL_ID, keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER'),
                    string(credentialsId: 'qa-mx-iris-node-pw', variable: 'QA_MX_ADM_PW')
                    ]) {
                    script {
 
                        //# Jenkins 변수를 셸 변수로 설정
                        initConfigEnv = [:] 
 
                        def remoteDeployScript = "" 
                        def QAServer = QA_SERVERS[0]      
                               
                        //ssh mapping  
                        QAServer.user = "${SSH_USER}"
                        QAServer.identityFile = "${SSH_KEY}"
                        // try-catch 블록으로 원격 실행 실패 시 롤백 로직을 처리
                        try {
                            
                            echo "--- Starting Deployment on Remote Server [${QAServer.host}]---" 

                            remoteDeployScript = deployToServerScript()        
                            // remoteExecute 함수를 호출하여 원격 서버에서 스크립트 실행                             
                            remoteExecute(remote: QAServer, command: sshRunAlwaysHeredoc(remoteDeployScript,initConfigEnv,false,false))           
                            
                            echo "--- Remote Deployment Finished Successfully ---"                        
 

                            initConfigEnv = [:]  //환경변수      
                           
                        } catch (e) {
                            // 원본 에러를 다시 발생시켜 빌드를 최종적으로 실패 처리
                            throw e
                        }
                    }
                }
            }
        }

        stage('Remote Checkout QA Server 2') {
            steps {
                // GitLab Credential을 Jenkins 변수로 불러오기
                withCredentials([
                   sshUserPrivateKey(credentialsId: SSH_CREDENTIAL_ID, keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER'),
                    string(credentialsId: GIT_CREDENTIAL_ID, variable: 'GITHUB_PAT'),
                    string(credentialsId: 'qa-mx-iris-node-pw', variable: 'QA_MX_ADM_PW')
                ]) {
                    script {                        
 
                        //# Jenkins 변수를 셸 변수로 설정
                        initConfigEnv = [BRANCH_TAG:"${env.BRANCH_TAG}"]
 
                        
                        def remoteCheckoutScript = ""
                        def QAServer = QA_SERVERS[1]      
                        //ssh mapping  
                        QAServer.user = "${SSH_USER}"
                        QAServer.identityFile = "${SSH_KEY}" 
                        // try-catch 블록으로 원격 실행 실패 시 롤백 로직을 처리
                        try {
                         
                            //github cicd checkout
                            remoteCheckoutScript = checkoutCode()  
                            echo "--- check ${env.BRANCH_TAG} ---"      
                            // remoteExecute 함수를 호출하여 원격 서버에서 스크립트 실행                             
                            BRANCH_TAG = remoteExecuteAndGetOutput(remote: QAServer, command: sshRunAlwaysHeredoc(remoteCheckoutScript,initConfigEnv,false,true))       
                            echo "--- check ${BRANCH_TAG} ---"                                                          
                            if (BRANCH_TAG == "1") {
                                  error "rollback 버전이 없습니다. github 에서 rollback tag 버전 확인후 수동 배포하십시요."
                            }  
                     
                            initConfigEnv = [:]  //환경변수                             
                             
                        } catch (e) { 
                            // 원본 에러를 다시 발생시켜 빌드를 최종적으로 실패 처리
                            throw e
                        }  
                    }
                }
            }
        }
 
        // 젠킨스 credentials 추출
        stage('Deploy and Verify QA Server 2') {
            steps {
                script {
                    withCredentials([
                        sshUserPrivateKey(credentialsId: SSH_CREDENTIAL_ID, keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER') , 
                        usernamePassword(credentialsId: 'qa-mem-mx-iris-db-credentials',usernameVariable: 'DB_USER', passwordVariable: 'DB_PASS') ,
                        usernamePassword(credentialsId: 'qa-mx-iris-nplm-db-credentials',usernameVariable: 'NPLM_USER', passwordVariable: 'NPLM_PW') ,
                        string(credentialsId: 'qa-mem-mx-iris-mendix-lic-credentials', variable: 'LIC_KEY') ,
                        string(credentialsId: 'qa-mx-iris-adm-app', variable: 'ADMIN_PASS'),
                        string(credentialsId: 'qa-mx-iris-iam-api-user-pw', variable: 'IAMAPIUSER_PW'),       
                        string(credentialsId: 'qa-mx-iris-saml20-keystore-pw', variable: 'SAML20_KEYSTORE_PASSWORD'),   
                        string(credentialsId: 'qa-mx-iris-nplm-consumer-api-key', variable: 'NPLM_DEFAULT_CONSUMER_API_KEY'), 
                        string(credentialsId: 'qa-mx-iris-nplm-consumer-pw', variable: 'NPLM_DEFAULT_CONSUMER_PWD') ,    
                        string(credentialsId: 'qa-mx-iris-node-pw', variable: 'QA_MX_ADM_PW')
                    ]) {
 
                        //# Jenkins 변수를 셸 변수로 설정
                        initConfigEnv = [:]
 
                        echo "--- Running Deploy and Verify ---"

                        def remoteEnvScript = ""
//                        def envContent = "${env.ENV_CONFIG}"  
                        def envContent = """
DB_USER='${DB_USER}'
DB_PASS='${DB_PASS}'
NPLM_USER='${NPLM_USER}'
NPLM_PW='${NPLM_PW}'
LICENSE_KEY='${LIC_KEY}'
ADMIN_PASS='${ADMIN_PASS}'
IAMAPIUSER_PW='${IAMAPIUSER_PW}'
SAML20_KEYSTORE_PASSWORD='${SAML20_KEYSTORE_PASSWORD}'
NPLM_DEFAULT_CONSUMER_API_KEY='${NPLM_DEFAULT_CONSUMER_API_KEY}'
NPLM_DEFAULT_CONSUMER_PWD='${NPLM_DEFAULT_CONSUMER_PWD}'
                        """  
                        
                        def QAServer = QA_SERVERS[1]         
                        //ssh mapping  
                        QAServer.user = "${SSH_USER}"
                        QAServer.identityFile = "${SSH_KEY}"

                        // try-catch 블록으로 원격 실행 실패 시 롤백 로직을 처리
                        try { 
                         
                            remoteEnvScript = envScript(envContent)        
                            // remoteExecute 함수를 호출하여 원격 서버에서 스크립트 실행                             
                            remoteExecute(remote: QAServer, command: sshRunAlwaysHeredoc(remoteEnvScript,initConfigEnv,false,false))  
                         
                            initConfigEnv = [:]  //환경변수       
 
                        } catch (e) { 
                            // 원본 에러를 다시 발생시켜 빌드를 최종적으로 실패 처리
                            throw e
                        }
                    }
                }
            }
        }

        stage('Execute Remote Deployment QA Server 2') {
            steps {
                withCredentials([ 
                    string(credentialsId: GIT_CREDENTIAL_ID, variable: 'GITHUB_PAT'),
                    sshUserPrivateKey(credentialsId: SSH_CREDENTIAL_ID, keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER'),
                    string(credentialsId: 'qa-mx-iris-node-pw', variable: 'QA_MX_ADM_PW')
                    ]) {
                    script {
 
                        //# Jenkins 변수를 셸 변수로 설정
                        initConfigEnv = [:]
 
 
                        def remoteDeployScript = "" 
                        def QAServer = QA_SERVERS[1]      
                        //ssh mapping  
                        QAServer.user = "${SSH_USER}"
                        QAServer.identityFile = "${SSH_KEY}"
                        // try-catch 블록으로 원격 실행 실패 시 롤백 로직을 처리
                        try {
 
                            echo "--- Starting Deployment on Remote Server [${QAServer.host}]---" 
                                
                            remoteDeployScript = deployToServerScript()        
                            // remoteExecute 함수를 호출하여 원격 서버에서 스크립트 실행                             
                            remoteExecute(remote: QAServer, command: sshRunAlwaysHeredoc(remoteDeployScript,initConfigEnv,false,false))           
                            
                            echo "--- Remote Deployment Finished Successfully ---"                        
  
                            initConfigEnv = [:]  //환경변수      
                           
                        } catch (e) {
                            // 원본 에러를 다시 발생시켜 빌드를 최종적으로 실패 처리
                            throw e
                        }
                    }
                }
            }
        }

        stage('Update Jenkins Metadata') {
            steps {
                script {
                    currentBuild.displayName = "#${env.BUILD_NUMBER} ${BRANCH_TAG}"
                    currentBuild.description = "rollback of version ${BRANCH_TAG} finished."
                }
            }
        }
    }

    post {
        success {
            echo "[성공] Deployment Rollback pipeline succeeded."
        }
        failure {
            echo "[실패] Deployment Rollback failed."
        }
        always {
            echo "Deployment Rollback finished."
            cleanWs()
        }
    }
}
 
// ============================================================================= 
//  qa git clone 
// =============================================================================
def checkoutCode() {

  // 원격 서버에서 실행할 전체 셸 스크립트를 생성
    def remoteDeployCheckoutScript = """
        #!/bin/bash
        # -e: 오류 발생 시 즉시 중단
        # -u: 정의되지 않은 변수 사용 시 오류
        # -x: 실행되는 모든 명령어를 출력
        # -o pipefail: 파이프라인의 어느 한 곳이라도 실패하면 전체 실패 처리

        sudo mkdir -p ${env.APP_WRK_PATH}
        sudo chmod 755 -R  ${env.APP_WRK_PATH}
        sudo chown -R ${env.OS_USER}:${env.OS_OWNER}  ${env.APP_WRK_PATH}
      
        cd ${env.APP_WRK_PATH}     
        # === 2. 배포 설정(docker-compose) 저장소 체크아웃 ===
        echo "--- Checking out deployment repository ---" 
        if [ -d "${env.BRANCH_NAME}" ]; then
            rm -rf "${env.BRANCH_NAME}"
        fi
        
        git clone --depth 1 --no-tags -b ${env.BRANCH_NAME}  ${env.GITHUB_URL.replace('://', "://${GITHUB_PAT}@")}  ${env.BRANCH_NAME}

        cd ${env.BRANCH_NAME}
                                
        ## 태그 목록이 전부 있어야 git describe 가 정확하므로 전체 fetch 보장
        git fetch ${env.GITHUB_URL.replace('://', "://${GITHUB_PAT}@")}  --tags --force

        declare LATEST_TAG=""

       if [[ -z "\${BRANCH_TAG:-}" || "\${BRANCH_TAG:-}" = 'null' ]]; then                            
            ## 태그 브랜치로
            LATEST_TAG="\$(git for-each-ref --sort=-creatordate --format='%(refname:short)' "refs/tags/${env.BUILD_MODE}*" | head -n 1)"
            echo "===> LATEST_TAG - \${LATEST_TAG}"  
            if [ -z "\$LATEST_TAG" ]; then
                 LATEST_TAG="1"
            fi
 
        else
            LATEST_TAG="${env.BRANCH_TAG}"
        fi
 
        echo "===> Resolve hashes - \${LATEST_TAG}"  
        if [ "\$LATEST_TAG" != "1" ]; then
            ## BRANCH_TAG -> LATEST_TAG 유효성 확인
            SRC_BRANCH_HASH="\$(git rev-parse --verify --quiet \${LATEST_TAG} || true)"
            if [ -z "\${SRC_BRANCH_HASH}" ]; then
                echo "ERROR: LATEST_TAG not Found: \${LATEST_TAG}"  
                exit 1                            
            fi

            ##임시 브랜치 로컬 브랜치 생성 / 업데이트
            git checkout  -B  ${env.BRANCH_NAME}  \${LATEST_TAG}

            echo "--- branch -> checkout create ---"   
          
        fi

        echo "--- Remote checkout finished successfully ---"   
        
        echo "\$LATEST_TAG" | tr '+' '-'
        printf "__RESULT__:%s\\n" "\$LATEST_TAG"
    """ 
 
    return remoteDeployCheckoutScript
}


// =============================================================================
//  공통함수
//  Jenkins에서 전달된 환경 변수 설정
//  원자적쓰기 (base64 경유)
//  byte[] bytes = envContent.getBytes('UTF-8')
//  String bs64 = bytes.encodeBase64().toString()
//  writeFile file: 'env.tmp', text: envContent
// =============================================================================
def envScript(envContent) {
    def envScript = """ 
                #!/bin/bash
                # -e: 오류 발생 시 즉시 중단
                # -u: 정의되지 않은 변수 사용 시 오류
                # -x: 실행되는 모든 명령어를 출력
                # -o pipefail: 파이프라인의 어느 한 곳이라도 실패하면 전체 실패 처리

                cd ${env.APP_COMPOSE_PATH}        
                echo "--- Starting env on Remote Server ---"
                
                umask 077 
cat > .env.tmp <<'EOT'
${envContent}
EOT

                    sudo mv -f .env.tmp  .env
                    sudo chmod 600 .env
                    echo "--- Remote env Finished Successfully ---"
                """

    return envScript
}



// =============================================================================
//  공통함수
//  Docker compose run
// =============================================================================
def deployToServerScript() {

   // 원격 서버에서 실행할 전체 셸 스크립트를 Groovy GString으로 생성
    def deployScript = """   
                    #!/bin/bash
                    # -e: 오류 발생 시 즉시 중단
                    # -u: 정의되지 않은 변수 사용 시 오류
                    # -x: 실행되는 모든 명령어를 출력
                    # -o pipefail: 파이프라인의 어느 한 곳이라도 실패하면 전체 실패 처리

                    echo "--- Starting Deployment on Remote Server ---" 
                    cd ${env.APP_BRANCH_PATH}       
                    sudo chmod 755 -R ./docker                             
                    cd ${env.APP_COMPOSE_PATH} 
 
                    docker compose -p ${env.APP_NAME} up -d

                    # === 4. 헬스 체크 ===
                    echo "--- Starting Health Check ---"
                    COUNTER=0
                    MAX_RETRIES=12
                    HEALTHY=false
                    while [ \$COUNTER -lt \$MAX_RETRIES ]; do
                        echo "Attempt \$((COUNTER+1))/\$MAX_RETRIES..."
                        
                        # grep의 결과가 없어도 스크립트가 중단되지 않도록 || true 추가
                        HEALTHY_COUNT=\$(docker compose -p ${env.APP_NAME} ps --status running | grep -c '(healthy)' || true)
                        TOTAL_COUNT=\$(docker compose -p  ${env.APP_NAME} ps --status running | tail -n +2 | wc -l || true)
                        
                        if [ "\$TOTAL_COUNT" -gt 0 ] && [ "\$TOTAL_COUNT" -eq "\$HEALTHY_COUNT" ]; then
                            HEALTHY=true
                            echo "All services are healthy!" 
                            break
                        fi
                        COUNTER=\$((COUNTER+1))
                        sleep 10
                    done

                    if [ "\$HEALTHY" = "false" ]; then
                        echo " Health check failed! Current status:"
                        docker compose -p ${env.APP_NAME}  ps
                        exit 1 # 스크립트 실패 처리
                    fi

                    # 필터링으로 label이 적용되어 있는 값을 찾아  사용하지 않은 이미지 삭제                             
                    docker image prune -a -f --filter "label=project"

                    echo "--- Remote Deployment Finished Successfully ---" 
                """
        
    return  deployScript
 
}