##=============================================================================
## Mendix Runtime 환경변수
## 사용자 환경변수 기입하지 마세요 아래쪽에 기입
##=============================================================================
ENV=qa
TZ=Asia/Seoul
## mendix Config
LICENSE_ID="916a2778-998b-4ebb-aff1-f3ab8b7c034a"
LICENSE_KEY=${LICENSE_KEY} 
#DATABASE_ENDPOINT=postgres://mendix:mendix@10.173.193.68:15432/mendix
MXRUNTIME_DatabaseType="V_APP_DATABASE_TYPE"
MXRUNTIME_DatabaseJdbcUrl="V_APP_DATABASE_JDBC_URL"
MXRUNTIME_DatabaseUserName='${DB_USER}'
MXRUNTIME_DatabasePassword='${DB_PASS}'
MXRUNTIME_DatabaseName="V_APP_DATABASE_SID"
MXRUNTIME_ApplicationRootUrl="V_MXRUNTIME_APPLICATION_ROOT_URL"
MXRUNTIME_com_mendix_core_SameSiteCookies=None
MXRUNTIME_SessionTimeout="600000" 
MXRUNTIME_com_mendix_metrics_Type="micrometer"
MXRUNTIME_Metrics_Registries='[{"type": "prometheus", "settings": {"step": "1m"}}]' 
MXRUNTIME_Metrics_ApplicationTags='{"hostId": "V_NODE_HOSTNAME", "environment": "V_APP_NODE_IP"}'
MXRUNTIME_ConnectionPoolingMaxActive="2000"
MXRUNTIME_ConnectionPoolingMaxIdle="1000"
MXRUNTIME_ConnectionPoolingMinIdle="10"
MXRUNTIME_com_mendix_webui_StateSizeWarningThreshold=3000
MXRUNTIME_http_client_MaxConnectionsPerRoute=1000
MXRUNTIME_http_client_MaxConnectionsTotal=2000
##// Elastic APM
APM_PRODUCT_GROUP_ID = 'newplm'
APM_PRODUCT_ID = 'mendix-iris-qa'
APM_PRODUCT_PHASE = 'qa'
APM_AGENT_PATH = '/opt/mendix/build/model/lib/userlib'
APM_APPLICATION_PACKAGES ='axanalysis,axdata,axsimulation,communitycommons,crs_knox,databaseconnector,encryption,excelimporter,externaldatabaseconnector,feedbackmodule,logging,mxmodelreflection,objecthandling,oql,pmcommon,pmhcportfolio,pmplananalysis,pmplanexcel,pmplansimulation,pmstandardadvanced,pmstandardinfo,pmstandardinfo_diff,saml20,xlsreport'
JAVA_OPTS='["-javaagent:${env.APM_AGENT_PATH}/apm-agent.jar", "-Delastic.apm.server_url=https://apm.elastic.samsungds.net:8200", "-Delastic.apm.service_name=${env.APM_PRODUCT_GROUP_ID}--${env.APM_PRODUCT_ID}", "-Delastic.apm.environment=${env.APM_PRODUCT_PHASE}", "-Delastic.apm.global_labels=productgroupid=${env.APM_PRODUCT_GROUP_ID},productid=${env.APM_PRODUCT_ID}", "-Delastic.apm.secret_token=NmL5qhSBlPA2huTAmT", "-Delastic.apm.verify_server_cert=false", "-Delastic.apm.application_packages=${env.APM_APPLICATION_PACKAGES}", "-Delastic.apm.log_level=INFO", "-Dorg.eclipse.jetty.server.Request.maxFormContentSize=10485760" ]'
##S3_ENDPOINT="http://"
##S3_ACCESS_KEY_ID=""
##S3_SECRET_ACCESS_KEY="V_S3_SECRET" 
##S3_BUCKET_NAME="" 
ADMIN_PASSWORD='${ADMIN_PASS}'
IRIS_CPU_LIMIT="4.0"
IRIS_MEMORY_LIMIT="8G"
MEMORY_LIMIT="3072M"
HEAP_SIZE="2048M" 
JETTY_CONFIG={"runtime_max_threads":"200"}
LOGGING_CONFIG='{"Core":"INFO","ConnectionBus":"INFO"}'
#ScheduledEventExecution="SPECIFIED"
#MyScheduledEvents="Logging.CleanupDataLogging" 
ScheduledEventExecution="NONE"
SCHEDULED_EVENTS="SAML20.SE_LogCleanUp,SAML20.SE_SynchronizeIdPMetadata,Logging.CleanupDataLogging,Core.CleanupUserAccessLogging"
#SCHEDULED_EVENTS="SAML20.SE_LogCleanUp,SAML20.SE_SynchronizeIdPMetadata,Logging.CleanupDataLogging,Core.CleanupUserAccessLogging,NPLMIntegration.SCE_ZxOrgEmpInfm_Sync"
MXRUNTIME_UploadedFilesPath="/iris-data"

